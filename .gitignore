Tools/streaming/*.local.json
Tools/streaming/aws/*.local.*
Tools/streaming/aws/parameters*.json
Tools/streaming/aws/change-set*.json
Tools/streaming/certificates/
Tools/streaming/releases/

# Python validation cache
__pycache__/
*.py[cod]
