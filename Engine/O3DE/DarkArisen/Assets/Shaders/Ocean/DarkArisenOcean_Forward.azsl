/*
 * Dark Arisen ocean, forward pass: Gerstner displacement, Fresnel sky reflection and sun glint.
 * check: vs_6_2 MainVS
 * check: ps_6_2 MainPS
 */
#include "DarkArisenOceanCommon.azsli"
#include <Atom/Features/Pipeline/Forward/ForwardPassOutput.azsli>

struct VertexShaderInput
{
    float3 m_position : POSITION;
};

struct VertexShaderOutput
{
    float4 m_position : SV_Position;
    float3 m_worldPosition : TEXCOORD0;
    float3 m_normal : NORMAL;
    float m_crest : TEXCOORD1;
};

VertexShaderOutput MainVS(VertexShaderInput IN, uint instanceId : SV_InstanceID)
{
    VertexShaderOutput OUT;
    const OceanSurfacePoint surface = DisplaceOceanVertex(IN.m_position, instanceId);
    OUT.m_position = mul(ViewSrg::m_viewProjectionMatrix, float4(surface.m_position, 1.0));
    OUT.m_worldPosition = surface.m_position;
    OUT.m_normal = surface.m_normal;
    OUT.m_crest = surface.m_position.z;
    return OUT;
}

ForwardPassOutput MainPS(VertexShaderOutput IN, bool isFrontFace : SV_IsFrontFace)
{
    ForwardPassOutput OUT;
    // Seen from below (swimming, diving) the surface is lit from the other side.
    const float3 normal = normalize(isFrontFace ? IN.m_normal : -IN.m_normal);
    const float3 toCamera = normalize(ViewSrg::m_worldPosition - IN.m_worldPosition);
    const float facing = saturate(dot(normal, toCamera));
    const float fresnel = 0.02 + 0.98 * pow(1.0 - facing, 5.0);

    const float crest = saturate(0.5 + 0.5 * IN.m_crest);
    const float3 body = lerp(DarkArisenOceanMaterialSrg::m_deepColor, DarkArisenOceanMaterialSrg::m_shallowColor, crest);
    float3 color = lerp(body, DarkArisenOceanMaterialSrg::m_skyColor, fresnel);

    if (SceneSrg::m_directionalLightCount > 0)
    {
        const DirectionalLight sun = SceneSrg::m_directionalLights[0];
        const float3 toSun = normalize(-sun.m_direction);
        const float3 reflected = reflect(-toCamera, normal);
        const float glint = pow(saturate(dot(reflected, toSun)), 256.0);
        color += glint * DarkArisenOceanMaterialSrg::m_specularStrength * normalize(sun.m_rgbIntensityLux + 1e-4);
    }

    OUT.m_diffuseColor = float4(color, -1.0);
    OUT.m_specularColor = float4(0.0, 0.0, 0.0, 0.0);
    return OUT;
}
