/*
 * Dark Arisen terrain, forward pass: scanned detail layers under the macro colour, lit by the sun with the
 * engine's cascaded sun shadows; albedo, F0, roughness and normal go to the later passes for IBL and GI.
 * check: vs_6_2 MainVS
 * check: ps_6_2 MainPS
 */
#include "DarkArisenTerrainCommon.azsli"
#include <Atom/Features/Pipeline/Forward/ForwardPassSrg.azsli>
#include <Atom/Features/Pipeline/Forward/ForwardPassOutput.azsli>
#include <Atom/Features/PBR/AlphaUtils.azsli>  // o_opacity_mode, read by the sun shadow lookup
#include <Atom/Features/Shadow/DirectionalLightShadow.azsli>
#include <Atom/RPI/Math.azsli>

struct VertexShaderInput
{
    float3 m_position : POSITION;
    float3 m_normal : NORMAL;
    float2 m_uv0 : UV0;
};

struct VertexShaderOutput
{
    float4 m_position : SV_Position;
    float3 m_worldPosition : TEXCOORD0;
    float3 m_normal : NORMAL;
    float2 m_uv : TEXCOORD1;
};

VertexShaderOutput MainVS(VertexShaderInput IN, uint instanceId : SV_InstanceID)
{
    VertexShaderOutput OUT;
    const float4 world = mul(GetObjectToWorldMatrix(instanceId), float4(IN.m_position, 1.0));
    OUT.m_position = mul(ViewSrg::m_viewProjectionMatrix, world);
    OUT.m_worldPosition = world.xyz;
    OUT.m_normal = normalize(mul(GetObjectToWorldMatrixInverseTranspose(instanceId), IN.m_normal));
    OUT.m_uv = IN.m_uv0;
    return OUT;
}

ForwardPassOutput MainPS(VertexShaderOutput IN)
{
    ForwardPassOutput OUT;
    const TerrainSurface surface = DarkArisenTerrainEvaluate(IN.m_worldPosition, normalize(IN.m_normal), IN.m_uv);
    const float3 toCamera = normalize(ViewSrg::m_worldPosition - IN.m_worldPosition);

    float3 diffuse = float3(0.0, 0.0, 0.0);
    float3 specular = float3(0.0, 0.0, 0.0);
    if (SceneSrg::m_directionalLightCount > 0)
    {
        const DirectionalLight sun = SceneSrg::m_directionalLights[0];
        const float3 toSun = normalize(-sun.m_direction);
        const float lit = DirectionalLightShadow::GetVisibility(ViewSrg::m_shadowIndexDirectionalLight, IN.m_worldPosition, surface.m_normal, IN.m_position);
        const float NdotL = saturate(dot(surface.m_normal, toSun));
        diffuse = surface.m_albedo * (NdotL / 3.14159265) * sun.m_rgbIntensityLux * lit;
        const float3 halfway = normalize(toSun + toCamera);
        const float roughness = max(surface.m_roughness, 0.05);
        const float a2 = roughness * roughness * roughness * roughness;
        const float NdotH = saturate(dot(surface.m_normal, halfway));
        const float NdotV = max(saturate(dot(surface.m_normal, toCamera)), 1e-4);
        const float d = NdotH * NdotH * (a2 - 1.0) + 1.0;
        const float k = roughness * roughness * 0.5;
        const float visibility = 0.25 / ((NdotV * (1.0 - k) + k) * (NdotL * (1.0 - k) + k) + 1e-4);
        specular = (0.04 * a2 / (3.14159265 * d * d) * visibility) * NdotL * sun.m_rgbIntensityLux * lit;
    }

    OUT.m_diffuseColor = float4(diffuse, -1.0);
    OUT.m_specularColor = float4(specular, 1.0);
    OUT.m_albedo = float4(surface.m_albedo * surface.m_occlusion, surface.m_occlusion);
    OUT.m_specularF0 = float4(0.04, 0.04, 0.04, surface.m_roughness);
    OUT.m_normal = float4(EncodeNormalSignedOctahedron(surface.m_normal), EncodeUnorm2BitFlags(true, false));
    return OUT;
}
